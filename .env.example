# Apple Photos album name (must match exactly)
PHOTOS_ALBUM=Website

# Public CDN base URL for the R2 custom domain (no trailing slash)
# Example: https://cdn.yourdomain.com
PHOTOS_CDN_URL=

# Optional image processing knobs
PHOTOS_MAX_EDGE=2048
PHOTOS_JPEG_QUALITY=82

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PREFIX=photos

# rclone remote name from `rclone config`
RCLONE_ICLOUD_REMOTE=icloudphotos
